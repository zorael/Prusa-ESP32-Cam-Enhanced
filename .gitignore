### macOS Patch ###
# iCloud generated files
*.icloud

# End of https://www.toptal.com/developers/gitignore/api/c++,macos

# Internal AI assistant session files
.claude/

# web UI build toolchain (only needed to rebuild styles.css).
# package-lock.json is committed on purpose — same reasoning as the pinned
# platform URL in platformio.ini: an unpinned dependency can change the output
# under an unchanged source tree.
webpage/node_modules/

# auto-generated by pioarduino at build time
src/idf_component.yml

# device NVS dumps - contain WiFi password and Prusa Connect token
tools/nvs-backup*.bin
